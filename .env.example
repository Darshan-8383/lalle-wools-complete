# Copy this file to .env and fill in real values before going live.
# Leaving the gateway/shipping/email keys blank is fine for local development:
# only Cash on Delivery is offered, shipments are simulated, and emails print to
# the console. Nothing is ever charged or shipped for real until you add keys.

# ── Server ──────────────────────────────────────────────
PORT=4000
# Set to "production" on your live server (enables the strict safety checks, daily backups, quieter logs).
NODE_ENV=development
# Your public address — used for the sitemap, canonical link and social-share previews.
SITE_URL=http://localhost:4000
# Leave BLANK in production: the storefront is served by this same server, so no CORS is needed.
# Only if a *different* website must call this API, put its address here (comma-separate several).
# "*" (allow everyone) is accepted for local development only.
CLIENT_ORIGIN=
# Number of reverse proxies in front of this server (nginx/Render/Cloudflare = 1). Use 0 if exposed directly.
TRUST_PROXY=1

# ── Auth (required for admin panel + customer accounts) ─
# Generate with: node scripts/generate-jwt-secret.js
JWT_SECRET=

# ── Customer login: "Continue with Google" ──────────────
# 1. https://console.cloud.google.com/apis/credentials > Create credentials > OAuth client ID > "Web application"
# 2. Under "Authorised JavaScript origins" add your site (https://lallewools.com) AND http://localhost:4000 for testing
#    (no redirect URI is needed for the Google button)
# 3. Paste the Client ID here. It is not a secret. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=

# ── Admin panel login (http://localhost:4000/admin) ─────
ADMIN_EMAIL=admin@lallewools.com
# Generate with: node scripts/hash-password.js "your-new-password"
ADMIN_PASSWORD_HASH=

# ── Payment Gateway: Razorpay ───────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys (use TEST keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard > Settings > Webhooks (same secret you set there)
RAZORPAY_WEBHOOK_SECRET=

# ── Shipping: Shiprocket ────────────────────────────────
# Get these from your Shiprocket account: https://app.shiprocket.in
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# The exact "Pickup Location" nickname you set up in Shiprocket > Settings > Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# Your warehouse/pickup pincode, used for serviceability checks
SHIPROCKET_PICKUP_PINCODE=
# Optional but recommended: lets Shiprocket push status changes instantly.
# In Shiprocket > Settings > API > Webhooks add  https://YOURSITE/api/shipping/webhook  with this same token.
# Without it the site still updates by itself (polls Shiprocket every 15 minutes + whenever a customer opens the order).
SHIPROCKET_WEBHOOK_TOKEN=

# ── Email (order confirmation / shipped / cancelled) ────
# Works with any SMTP provider — Gmail (use an App Password, not your normal
# password), Zoho Mail, Amazon SES, SendGrid SMTP, Resend SMTP, your host, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LALLEWOOLS <no-reply@lallewools.store>"

# Must customers confirm their email (via a link we send) before they can place an order?
# Leave blank for the sensible default: required as soon as SMTP above is set up, off while it is blank
# (nobody could receive the link). Set true/false to force it either way. Needs SITE_URL in production.
REQUIRE_EMAIL_VERIFICATION=

# ── Custom Tee requests via WhatsApp (optional — blank hides the section) ──
# Admin's WhatsApp number with country code, digits only (e.g. 919876543210).
# The "Custom Tee" section sends customers to a WhatsApp chat with this number.
# You can also change it later in the admin panel (Settings tab), which overrides this value.
ADMIN_WHATSAPP=

# ── Footer links (optional — blank hides them) ──────────
SOCIAL_INSTAGRAM=
SOCIAL_TWITTER=
SOCIAL_YOUTUBE=
SOCIAL_DISCORD=

# ── Business details (shown on generated invoices) ──────
BUSINESS_NAME=LALLEWOOLS
BUSINESS_ADDRESS=Bengaluru, Karnataka, India
BUSINESS_EMAIL=support@lallewools.com
# Leave blank until you have GST registration; once registered, add it here
# so it appears on every invoice (a legal requirement once registered).
BUSINESS_GSTIN=
